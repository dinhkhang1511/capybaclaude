{
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [{ "type": "http", "url": "http://127.0.0.1:7654/hook", "timeout": 5 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "http", "url": "http://127.0.0.1:7654/hook", "timeout": 5 }] }
    ],
    "StopFailure": [
      { "matcher": "*", "hooks": [{ "type": "http", "url": "http://127.0.0.1:7654/hook", "timeout": 5 }] }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt|agent_needs_input",
        "hooks": [{ "type": "http", "url": "http://127.0.0.1:7654/hook", "timeout": 5 }]
      }
    ],
    "SessionEnd": [
      { "matcher": "*", "hooks": [{ "type": "http", "url": "http://127.0.0.1:7654/hook", "timeout": 5 }] }
    ]
  }
}
